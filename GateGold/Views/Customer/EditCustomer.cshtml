@model EntityLayer.Concrete.Customer

@{
    ViewBag.Title = "EditCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Cari Düzenle</h2>

@using (Html.BeginForm("EditCustomer", "Customer", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.CariID)

    <div class="mb-3">
        @Html.LabelFor(x => x.CariKodu)
        @Html.TextBoxFor(x => x.CariKodu, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariKodu, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.CariAdi)
        @Html.TextBoxFor(x => x.CariAdi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariAdi, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.CariTipi)
        @Html.TextBoxFor(x => x.CariTipi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariTipi, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.VergiDairesi)
        @Html.TextBoxFor(x => x.VergiDairesi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.VergiDairesi, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.VergiNo)
        @Html.TextBoxFor(x => x.VergiNo, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.VergiNo, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.TCKimlikNo)
        @Html.TextBoxFor(x => x.TCKimlikNo, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.TCKimlikNo, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.Adres)
        @Html.TextBoxFor(x => x.Adres, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Adres, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.Telefon)
        @Html.TextBoxFor(x => x.Telefon, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Telefon, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.Email)
        @Html.TextBoxFor(x => x.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.WebSitesi)
        @Html.TextBoxFor(x => x.WebSitesi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.WebSitesi, "", new { @class = "text-danger" })
    </div>

    <button type="submit" class="btn btn-primary">Güncelle</button>
}