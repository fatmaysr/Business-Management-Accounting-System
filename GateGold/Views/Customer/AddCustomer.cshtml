@model EntityLayer.Concrete.Customer

@{
    ViewBag.Title = "Cari Tanımla";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Yeni Cari Tanımla</h3>
                <p class="text-muted fs-14 mb-0">Sisteme yeni müşteri, tedarikçi veya bayi kaydedin.</p>
            </div>

            @using (Html.BeginForm("AddCustomer", "Customer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-6">
                        @Html.LabelFor(x => x.CariKodu, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.CariKodu, new { @class = "form-control", placeholder = "Cari kodu giriniz" })
                        @Html.ValidationMessageFor(x => x.CariKodu, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(x => x.CariAdi, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.CariAdi, new { @class = "form-control", placeholder = "Firma veya kişi adı" })
                        @Html.ValidationMessageFor(x => x.CariAdi, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(x => x.CariTipi, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.CariTipi, new { @class = "form-control", placeholder = "Müşteri / Tedarikçi vb." })
                        @Html.ValidationMessageFor(x => x.CariTipi, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(x => x.Telefon, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.Telefon, new { @class = "form-control", placeholder = "+90 5XX XXX XX XX" })
                        @Html.ValidationMessageFor(x => x.Telefon, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(x => x.Email, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.Email, new { @class = "form-control", placeholder = "ornek@firma.com" })
                        @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-6">
                        @Html.LabelFor(x => x.VergiNo, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.VergiNo, new { @class = "form-control", placeholder = "Vergi numarası" })
                        @Html.ValidationMessageFor(x => x.VergiNo, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(x => x.Adres, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(x => x.Adres, new { @class = "form-control", placeholder = "Açık adres..." })
                        @Html.ValidationMessageFor(x => x.Adres, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-12 d-flex gap-2 mt-4">
                        <a href="@Url.Action("CustomerList", "Customer")" class="btn btn-outline-secondary w-50">İptal</a>
                        <button type="submit" class="btn btn-primary w-50">Kaydet</button>
                    </div>

                    <div class="col-12 mt-2">
                        @Html.ValidationSummary(true, "", new { @class = "text-danger fs-13" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>