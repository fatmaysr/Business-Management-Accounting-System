@model EntityLayer.Concrete.Customer

@{
    ViewBag.Title = "AddCustomer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Yeni Cari Ekle</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="mb-3">
        @Html.LabelFor(x => x.CariKodu)
        @Html.TextBoxFor(x => x.CariKodu, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariKodu, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.CariAdi)
        @Html.TextBoxFor(x => x.CariAdi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariAdi, "", new { @class = "text-danger" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(x => x.CariTipi)
        @Html.TextBoxFor(x => x.CariTipi, new { @class = "form-control" })
        @Html.ValidationMessageFor(x => x.CariTipi, "", new { @class = "text-danger" })
    </div>

    <!-- Diğer alanlar için de aynı şekilde ValidationMessageFor ekleyebilirsin -->

    <button type="submit" class="btn btn-success">Kaydet</button>

    <div class="mt-3">
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    </div>
}
