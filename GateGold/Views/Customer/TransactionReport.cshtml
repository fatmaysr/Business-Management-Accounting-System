
@{
    ViewBag.Title = " Cari Hesap Haraket Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4 fw-bold text-primary">📊 Cari Hesap Hareket Raporu</h2>

<!-- 🔍 Filtreleme Paneli -->
<div class="card shadow-sm border-0 mb-4">
 
    <div class="card-body">
        <form class="row g-3">
            <!-- Cari Seçimi -->
            <div class="col-md-4">
                <label class="form-label">Cari Seç</label>
                <select class="form-select" id="cariSec" name="cariSec">
                    <option selected disabled>Bir cari seçiniz</option>
                    @if (ViewBag.Customers != null)
                    {
                        foreach (var cari in ViewBag.Customers)
                        {
                            <option value="@cari.Value">@cari.Text</option>
                        }
                    }
                </select>

            </div>

            <!-- Tarih Aralığı -->
            <div class="col-md-3">
                <label class="form-label">Başlangıç Tarihi</label>
                <input type="date" class="form-control" name="startDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Bitiş Tarihi</label>
                <input type="date" class="form-control" name="endDate" />
            </div>

            <!-- Filtrele Butonu -->
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="bi bi-search me-1"></i>Filtrele
                </button>
            </div>
        </form>
    </div>
</div>

<!-- 📄 Hareket Tablosu -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-light fw-semibold">
        <i class="bi bi-list-ul me-2"></i>İşlem Geçmişi
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle text-center m-0">
                <thead class="table-primary">
                    <tr>
                        <th>Tarih</th>
                        <th>İşlem Türü</th>
                        <th>Açıklama</th>
                        <th>Alacak (₺)</th>
                        <th>Borç (₺)</th>
                        <th>Bakiye (₺)</th>
                    </tr>
                </thead>
         
            </table>
        </div>
    </div>
</div>

<!-- 📥 Dışa Aktarma Butonları -->
<div class="text-end mt-3">
    <button class="btn btn-outline-secondary me-2">
        <i class="bi bi-file-earmark-excel"></i> Excel’e Aktar
    </button>
    <button class="btn btn-outline-secondary">
        <i class="bi bi-printer"></i> Yazdır
    </button>
</div>


