@model IEnumerable<EntityLayer.Concrete.Customer>
@{
    ViewBag.Title = "CustomerList";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4 fw-bold text-primary">Cari Listesi</h2>

<div class="mb-3 d-flex justify-content-between align-items-center">
    <div class="input-group w-50">
        <span class="input-group-text bg-white border-end-0">
            <i class="bi bi-search"></i>
        </span>
        <input type="text" class="form-control border-start-0" placeholder="Cari adı veya kodu ile ara..." />
    </div>

    <div class="d-flex gap-2">
        <a href="@Url.Action("ExportToExcel", "Customer")" class="btn btn-success px-3 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="feather-file-text"></i> Excel'e Aktar
        </a>

        <a href="@Url.Action("AddCustomer", "Customer")" class="btn btn-primary px-4 fw-semibold">
            + Yeni Cari Ekle
        </a>
    </div>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-primary text-center fw-bold">
            <tr>
                <th style="width: 5%;">#</th>
                <th style="width: 20%;">Cari Adı</th>
                <th style="width: 15%;">Cari Kodu</th>
                <th style="width: 10%;">Tür</th>
                <th style="width: 15%;">Telefon</th>
                <th style="width: 15%;">E-Posta</th>
                <th style="width: 10%;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="text-center">
                    <td>@item.CariID</td>
                    <td>@item.CariAdi</td>
                    <td>@item.CariKodu</td>
                    <td>@item.CariTipi</td>
                    <td>@item.Telefon</td>
                    <td>@item.Email</td>
                    <td>
                      
                    </td>
                    <<td>
    <a href="@Url.Action("EditCustomer", "Customer", new { id = item.CariID })" class="btn btn-sm btn-warning">
        Düzenle
    </a>

    @using (Html.BeginForm("DeleteCustomer", "Customer", new { id = item.CariID }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?');">
            Sil
        </button>
    }
</td>

                </tr>
            }
        </tbody>
    </table>
</div>
