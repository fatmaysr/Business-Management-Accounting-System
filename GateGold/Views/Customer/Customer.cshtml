
@{
    ViewBag.Title = "Cari Tanımla ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<h2 class="text-center my-4 fw-bold text-primary">📋 Cari Tanımla</h2>

<div class="card shadow-lg border-0 p-4 bg-light">
    <form class="row g-4">
        <!-- Cari Bilgileri -->
        <div class="col-12">
            <h5 class="text-secondary border-bottom pb-2 mb-3">Cari Bilgileri</h5>
        </div>

        <div class="col-md-6">
            <label for="cariAdi" class="form-label">Cari Adı</label>
            <input type="text" class="form-control" id="cariAdi" name="cariAdi" placeholder="Cari Adı Giriniz" />
        </div>

        <div class="col-md-6">
            <label for="cariKodu" class="form-label">Cari Kodu</label>
            <input type="text" class="form-control" id="cariKodu" name="cariKodu" placeholder="Cari Kodu Giriniz" />
        </div>

        <div class="col-md-6">
            <label for="cariTuru" class="form-label">Cari Türü</label>
            <select id="cariTuru" class="form-select" name="cariTuru">
                <option value="">Seçiniz</option>
                <option>Müşteri</option>
                <option>Tedarikçi</option>
                <option>Bayi</option>
            </select>
        </div>

        <div class="col-md-6">
            <label for="vergiNo" class="form-label">Vergi Numarası</label>
            <input type="text" class="form-control" id="vergiNo" name="vergiNo" placeholder="Vergi No Giriniz" />
        </div>

        <!-- İletişim Bilgileri -->
        <div class="col-12">
            <h5 class="text-secondary border-bottom pb-2 mt-4 mb-3">📞İletişim Bilgileri</h5>
        </div>

        <div class="col-md-6">
            <label for="telefon" class="form-label">Telefon</label>
            <input type="tel" class="form-control" id="telefon" name="telefon" placeholder="+90 5XX XXX XX XX" />
        </div>

        <div class="col-md-6">
            <label for="email" class="form-label">E-Posta</label>
            <input type="email" class="form-control" id="email" name="email" placeholder="ornek@firma.com" />
        </div>

        <div class="col-md-6">
            <label for="adres" class="form-label">Adres</label>
            <textarea class="form-control" id="adres" name="adres" rows="2" placeholder="Firmanın açık adresi..."></textarea>
        </div>

        <div class="col-md-6">
            <label for="aciklama" class="form-label">Açıklama</label>
            <textarea class="form-control" id="aciklama" name="aciklama" rows="2" placeholder="Açıklama giriniz..."></textarea>
        </div>

        <!-- Durum -->
        <div class="col-md-12 mt-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="aktifMi" name="aktifMi" checked />
                <label class="form-check-label text-primary fw-semibold" for="aktifMi">
                    Aktif olarak tanımlansın
                </label>
            </div>
        </div>

        <!-- Buton -->
        <div class="col-12 mt-4 text-end">
            <button type="submit" class="btn btn-primary px-5 shadow-sm">
                <i class="bi bi-save me-1"></i> Cari Tanımla
            </button>
        </div>
    </form>
</div>