@{
    ViewBag.Title = "Cari Tanımla";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Cari Tanımla</h3>
                <p class="text-muted fs-14 mb-0">Yeni bir müşteri, tedarikçi veya bayi hesabı oluşturun.</p>
            </div>

            <form class="row g-3">
                <!-- Cari Bilgileri -->
                <div class="col-12">
                    <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">Cari Bilgileri</h6>
                </div>

                <div class="col-md-6">
                    <label for="cariAdi" class="form-label text-muted fs-13 fw-semibold">CARİ ADI</label>
                    <input type="text" class="form-control" id="cariAdi" name="cariAdi" placeholder="Cari adı giriniz" />
                </div>

                <div class="col-md-6">
                    <label for="cariKodu" class="form-label text-muted fs-13 fw-semibold">CARİ KODU</label>
                    <input type="text" class="form-control" id="cariKodu" name="cariKodu" placeholder="Cari kodu giriniz" />
                </div>

                <div class="col-md-6">
                    <label for="cariTuru" class="form-label text-muted fs-13 fw-semibold">CARİ TÜRÜ</label>
                    <select id="cariTuru" class="form-select" name="cariTuru">
                        <option value="">Seçiniz</option>
                        <option>Müşteri</option>
                        <option>Tedarikçi</option>
                        <option>Bayi</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="vergiNo" class="form-label text-muted fs-13 fw-semibold">VERGİ NUMARASI</label>
                    <input type="text" class="form-control" id="vergiNo" name="vergiNo" placeholder="Vergi No giriniz" />
                </div>

                <!-- İletişim Bilgileri -->
                <div class="col-12 mt-4">
                    <h6 class="text-primary fw-bold border-bottom pb-2 mb-3">İletişim & Adres Bilgileri</h6>
                </div>

                <div class="col-md-6">
                    <label for="telefon" class="form-label text-muted fs-13 fw-semibold">TELEFON</label>
                    <input type="tel" class="form-control" id="telefon" name="telefon" placeholder="+90 5XX XXX XX XX" />
                </div>

                <div class="col-md-6">
                    <label for="email" class="form-label text-muted fs-13 fw-semibold">E-POSTA</label>
                    <input type="email" class="form-control" id="email" name="email" placeholder="ornek@firma.com" />
                </div>

                <div class="col-md-6">
                    <label for="adres" class="form-label text-muted fs-13 fw-semibold">ADRES</label>
                    <textarea class="form-control" id="adres" name="adres" rows="2" placeholder="Firmanın açık adresi..."></textarea>
                </div>

                <div class="col-md-6">
                    <label for="aciklama" class="form-label text-muted fs-13 fw-semibold">AÇIKLAMA</label>
                    <textarea class="form-control" id="aciklama" name="aciklama" rows="2" placeholder="Açıklama giriniz..."></textarea>
                </div>

                <!-- Durum -->
                <div class="col-md-12 mt-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="aktifMi" name="aktifMi" checked />
                        <label class="form-check-label text-dark fw-semibold fs-14" for="aktifMi">
                            Aktif olarak tanımlansın
                        </label>
                    </div>
                </div>

                <!-- Butonlar -->
                <div class="col-12 d-flex gap-2 mt-4">
                    <a href="@Url.Action("CustomerList", "Customer")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">
                        Cari Tanımla
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>