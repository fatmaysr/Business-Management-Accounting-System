@model EntityLayer.Concrete.CurrencyDetail

@{
    ViewBag.Title = "EditCurrencyDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-primary text-center">Döviz Düzenle</h2>

@using (Html.BeginForm("EditCurrencyDetail", "Currency", FormMethod.Post, new { @class = "row g-3" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CurrecyDetailId)
    @Html.HiddenFor(m => m.CariID)

    <div class="col-md-6">
        <label for="Type" class="form-label">Tür <span class="text-danger">*</span></label>
        <select id="Type" name="Type" class="form-select" required>
            <option value="1" @(Model.Type == 1 ? "selected" : "")>Döviz Alındı</option>
            <option value="2" @(Model.Type == 2 ? "selected" : "")>Döviz Verildi</option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="CariID" class="form-label">Cari <span class="text-danger">*</span></label>
        <select id="CariID" name="CariID" class="form-select" required disabled>
            @foreach (var customer in ViewBag.Customers as List<EntityLayer.Concrete.Customer> ?? new List<EntityLayer.Concrete.Customer>())
            {
                <option value="@customer.CariID" @(Model.CariID == customer.CariID ? "selected" : "")>@customer.CariAdi</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label for="Unit" class="form-label">Para Birimi <span class="text-danger">*</span></label>
        <select id="Unit" name="Unit" class="form-select" required>
            <option value="TRY" @(Model.Unit == "TRY" ? "selected" : "")>₺ - Türk Lirası</option>
            <option value="USD" @(Model.Unit == "USD" ? "selected" : "")>$ - Amerikan Doları</option>
            <option value="EUR" @(Model.Unit == "EUR" ? "selected" : "")>€ - Euro</option>
            <option value="GBP" @(Model.Unit == "GBP" ? "selected" : "")>£ - İngiliz Sterlini</option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="Amount" class="form-label">Tutar</label>
        <input type="number" step="0.01" min="0" class="form-control" id="Amount" name="Amount" value="@Model.Amount" required />
    </div>

    <div class="col-md-6">
        <label for="ExchangeRate" class="form-label">Kur</label>
        <input type="number" step="0.0001" class="form-control" id="ExchangeRate" name="ExchangeRate" value="@Model.ExchangeRate" />
    </div>

    <div class="col-md-6">
        <label for="Total" class="form-label">Toplam</label>
        <input type="text" class="form-control" id="Total" name="Total" value="@Model.Total" />
    </div>

    <div class="col-12">
        <label for="Description" class="form-label">Açıklama</label>
        <textarea id="Description" name="Description" class="form-control" rows="3">@Model.Description</textarea>
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
        <a href="@Url.Action("CurrencyDetailList", "Currency", new { currencyId = Model.CariID })" class="btn btn-outline-secondary">İptal</a>
        <button type="submit" class="btn btn-primary">Güncelle</button>
    </div>
}