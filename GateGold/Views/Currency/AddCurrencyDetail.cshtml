@model EntityLayer.Concrete.CurrencyDetail

@{
    ViewBag.Title = "AddCurrencyDetail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-primary text-center">Döviz Ekle</h2>

<form method="post" action="/Currency/AddCurrencyDetail" class="row g-3">

    <div class="col-md-6">
        <label for="Type" class="form-label">Tür <span class="text-danger">*</span></label>
        <select id="Type" name="Type" class="form-select" required>
            <option value="">-- Tür Seçiniz --</option>
            <option value="1">Döviz Alındı</option>
            <option value="2">Döviz Verildi</option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="CariID" class="form-label">Cari <span class="text-danger">*</span></label>
        <select id="CariID" name="CariID" class="form-select" required>
            <option value="">-- Cari Seçiniz --</option>
            @foreach (var customer in ViewBag.Customers as List<EntityLayer.Concrete.Customer>)
            {
                <option value="@customer.CariID">@customer.CariAdi</option>
            }
        </select>
    </div>

    <div class="col-md-6">
        <label for="Unit" class="form-label">Para Birimi <span class="text-danger">*</span></label>
        <select id="Unit" name="Unit" class="form-select" required>
            <option value="">Seçiniz</option>
            <option value="TRY">₺ - Türk Lirası (TRY)</option>
            <option value="USD">$ - Amerikan Doları (USD)</option>
            <option value="EUR">€ - Euro (EUR)</option>
            <option value="GBP">£ - İngiliz Sterlini (GBP)</option>
            <option value="CHF">Fr. - İsviçre Frangı (CHF)</option>
            <option value="CAD">C$ - Kanada Doları (CAD)</option>
            <option value="AUD">A$ - Avustralya Doları (AUD)</option>
            <option value="JPY">¥ - Japon Yeni (JPY)</option>
            <option value="CNY">¥ - Çin Yuanı (CNY)</option>
        </select>
    </div>

    <div class="col-md-6">
        <label for="Amount" class="form-label">Tutar <span class="text-danger">*</span></label>
        <input type="number" step="0.01" min="0" class="form-control" id="Amount" name="Amount" placeholder="Tutarı girin" required />
    </div>

    <div class="col-md-6">
        <label for="ExchangeRate" class="form-label">Kur</label>
        <input type="number" step="0.0001" class="form-control" id="ExchangeRate" name="ExchangeRate" placeholder="Kur girin" />
    </div>

    <div class="col-md-6">
        <label for="Total" class="form-label">Toplam</label>
        <input type="text" class="form-control" id="Total" name="Total" placeholder="Toplam" />
    </div>

    <div class="col-12">
        <label for="Description" class="form-label">Açıklama</label>
        <textarea id="Description" name="Description" class="form-control" rows="3" placeholder="İsterseniz açıklama ekleyin..."></textarea>
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
        <a href="/Currency/CurrencyDetailList" class="btn btn-outline-secondary">İptal</a>
        <button type="submit" class="btn btn-primary">Kaydet</button>
    </div>

</form>
