@model EntityLayer.Concrete.Currency

@{
    ViewBag.Title = "EditCurrency";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-primary text-center">Döviz Kaydı Düzenle</h2>

@using (Html.BeginForm("EditCurrency", "Currency", FormMethod.Post, new { @class = "row g-3" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CurrencyId)

    <div class="col-md-6">
        <label class="form-label">Tarih</label>
        <input type="date" class="form-control" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="col-md-6">
        <label class="form-label">Cari ID</label>
        <input type="number" class="form-control" name="CariID" value="@Model.CariID" required />
    </div>

    <div class="col-md-6">
        <label class="form-label">Ad</label>
        <input type="text" class="form-control" name="Name" value="@Model.Name" required />
    </div>

    <div class="col-md-6">
        <label class="form-label">Adres</label>
        <input type="text" class="form-control" name="Address" value="@Model.Address" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Telefon</label>
        <input type="text" class="form-control" name="Phone" value="@Model.Phone" />
    </div>

    <div class="col-md-6">
        <label class="form-label">E-posta</label>
        <input type="email" class="form-control" name="Email" value="@Model.Email" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Vergi No</label>
        <input type="text" class="form-control" name="TaxNumber" value="@Model.TaxNumber" />
    </div>

    <div class="col-md-6">
        <label class="form-label">IBAN</label>
        <input type="text" class="form-control" name="Iban" value="@Model.Iban" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Vergi Dairesi</label>
        <input type="text" class="form-control" name="TaxAdmin" value="@Model.TaxAdmin" />
    </div>

    <div class="col-md-6">
        <label class="form-label">Durum</label>
        <select class="form-select" name="Status">
            <option value="">Seçiniz</option>
            <option value="1" @(Model.Status == 1 ? "selected" : "")>Aktif</option>
            <option value="0" @(Model.Status == 0 ? "selected" : "")>Pasif</option>
        </select>
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
        <a href="@Url.Action("CurrencyBalanceList", "Currency")" class="btn btn-outline-secondary">İptal</a>
        <button type="submit" class="btn btn-primary">Güncelle</button>
    </div>
}