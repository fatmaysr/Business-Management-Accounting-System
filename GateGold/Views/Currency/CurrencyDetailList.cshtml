@model IEnumerable<EntityLayer.Concrete.CurrencyDetail>

@{
    ViewBag.Title = "CurrencyDetailList";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var currency = ViewBag.Currency as EntityLayer.Concrete.Currency;
}

<h2 class="mb-4 text-primary text-center">Döviz Detay Listesi - @(currency?.Name ?? "Bilinmeyen")</h2>

<div class="d-flex justify-content-between align-items-center mb-4">
    <input type="text" class="form-control w-50" placeholder="Cari, Para Birimi veya Açıklama ile ara..." id="searchInput" />

    @if (currency != null)
    {
        <a href="@Url.Action("AddCurrencyDetail", "Currency", new { currencyId = currency.CurrencyId })"
           class="btn btn-primary px-4 d-flex align-items-center gap-2 shadow-sm">
            <i class="bi bi-plus-lg fs-5"></i> Yeni Döviz Ekle
        </a>
    }
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-bordered table-hover align-middle text-center mb-0">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Cari</th>
                <th>Tür</th>
                <th>Tutar</th>
                <th>Kur</th>
                <th>Toplam</th>
                <th>Para Birimi</th>
                <th>Açıklama</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.CurrecyDetailId</td>
                    <td>@item.Customer?.Name</td>
                    <td>@(item.Type == 1 ? "Alındı" : item.Type == 2 ? "Verildi" : "Bilinmiyor")</td>
                    <td>@item.Amount</td>
                    <td>@item.ExchangeRate</td>
                    <td>@item.Total</td>
                    <td>@item.Unit</td>
                    <td>@item.Description</td>
                    <td>
                        <a href="@Url.Action("EditCurrencyDetail", "Currency", new { id = item.CurrecyDetailId })"
                           class="btn btn-sm btn-warning">Düzenle</a>
                        <a href="@Url.Action("DeleteCurrencyDetail", "Currency", new { id = item.CurrecyDetailId })"
                           class="btn btn-sm btn-danger" onclick="return confirm('Silmek istediğinize emin misiniz?')">Sil</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
