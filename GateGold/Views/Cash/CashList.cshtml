@model IEnumerable<EntityLayer.Concrete.CashCase>

@{
    ViewBag.Title = "Nakit Kasa Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4 fw-bold text-primary">Nakit Kasa Listesi</h2>

<table class="table table-bordered table-striped mt-3">
    <thead class="table-primary">
        <tr>
            <th>Kasa Adı</th>
            <th>Kasa Kodu</th>
            <th>Para Birimi</th>
            <th>Durum</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CaseName</td>
                <td>@item.CaseCode</td>
                <td>@item.Currency</td>
                <td>@(item.Status == 1 ? "Aktif" : "Pasif")</td>
                <td>
                    @Html.ActionLink("Düzenle", "EditCash", new { id = item.CaseId }, new { @class = "btn btn-warning btn-sm" })
                    @Html.ActionLink("Sil", "DeleteCash", new { id = item.CaseId }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Silmek istediğinize emin misiniz?');" })
                </td>
            </tr>
        }
    </tbody>
</table>
