@model IEnumerable<EntityLayer.Concrete.CashCase>

@{
    ViewBag.Title = "Nakit Kasa Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Nakit Kasa Listesi</h2>
        <p class="text-muted fs-14 mb-0">Sistemde tanımlı olan kasaları ve durumlarını yönetin.</p>
    </div>
    <a href="@Url.Action("AddCash", "Cash")" class="btn btn-primary">
        <i class="feather-plus me-1"></i> Nakit Kasa Ekle
    </a>
</div>

<div class="card border-0 shadow-sm p-3" style="border-radius: 16px !important;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted fs-12">
                <tr>
                    <th>Kasa Adı</th>
                    <th>Kasa Kodu</th>
                    <th>Para Birimi</th>
                    <th>Durum</th>
                    <th style="width: 18%;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-semibold text-dark">@item.CaseName</td>
                            <td><span class="badge bg-soft-primary text-primary">@item.CaseCode</span></td>
                            <td class="fw-semibold">@item.Currency</td>
                            <td>
                                <span class="badge @(item.Status == 1 ? "bg-soft-success text-success" : "bg-soft-danger text-danger")">
                                    @(item.Status == 1 ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    @Html.ActionLink("Düzenle", "EditCash", new { id = item.CaseId }, new { @class = "btn btn-sm btn-soft-warning text-warning px-3" })
                                    @Html.ActionLink("Sil", "DeleteCash", new { id = item.CaseId }, new { @class = "btn btn-sm btn-soft-danger text-danger px-3", onclick = "return confirm('Silmek istediğinize emin misiniz?');" })
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Kayıtlı nakit kasa bulunmuyor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>