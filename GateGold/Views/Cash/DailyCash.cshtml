@model IEnumerable<EntityLayer.Concrete.CaseTransaction>
@{
    ViewBag.Title = "Günlük Kasa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Günlük Kasa Raporu</h2>
        <p class="text-muted fs-14 mb-0">Seçilen tarihe ait kasa hareketlerini inceleyin.</p>
    </div>
</div>

<!-- Tek Tarih Seçme Formu -->
<div class="card border-0 shadow-sm p-4 mb-4" style="border-radius: 16px !important;">
    @using (Html.BeginForm("DailyCash", "Cash", FormMethod.Get, new { @class = "row g-3 align-items-end" }))
    {
        <div class="col-md-4">
            <label for="selectedDate" class="form-label text-muted fs-13 fw-semibold">TARİH SEÇİN</label>
            <input type="date" class="form-control" id="selectedDate" name="selectedDate" value="@Request.QueryString["selectedDate"]" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">Listele</button>
        </div>
    }
</div>

<!-- Günlük Kasa Tablosu -->
<div class="card border-0 shadow-sm p-3" style="border-radius: 16px !important;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted fs-12">
                <tr>
                    <th>Tarih</th>
                    <th>Cari</th>
                    <th>Açıklama</th>
                    <th class="text-end">Verilen</th>
                    <th class="text-end">Alınan</th>
                    <th>Para Birimi</th>
                    <th style="width: 15%;">İşlem</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Date.ToString("dd.MM.yyyy")</td>
                            <td class="fw-semibold">@item.CariID</td>
                            <td class="text-muted">@item.Description</td>
                            <td class="text-end text-danger fw-semibold">@(item.Type == "Gider" ? item.Amount.ToString("N2") : "-")</td>
                            <td class="text-end text-success fw-semibold">@(item.Type == "Gelir" ? item.Amount.ToString("N2") : "-")</td>
                            <td><span class="badge bg-soft-secondary text-dark">@item.Currency</span></td>
                            <td>
                                <div class="d-flex gap-2">
                                    @Html.ActionLink("Düzenle", "EditCashTransaction", new { id = item.CaseTransactionId }, new { @class = "btn btn-sm btn-soft-warning text-warning px-2" })
                                    @Html.ActionLink("Sil", "DeleteCashTransaction", new { id = item.CaseTransactionId }, new { @class = "btn btn-sm btn-soft-danger text-danger px-2", onclick = "return confirm('Silmek istediğinize emin misiniz?');" })
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Seçilen tarihte işlem bulunamadı.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>