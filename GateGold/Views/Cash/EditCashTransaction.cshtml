@model EntityLayer.Concrete.CaseTransaction

@{
    ViewBag.Title = "Kasa Hareketi Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-9">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Kasa Hareketi Düzenle</h3>
                <p class="text-muted fs-14 mb-0">Mevcut kasa hareket kaydını güncelleyin.</p>
            </div>

            @using (Html.BeginForm("EditCashTransaction", "Cash", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CaseTransactionId)

                <div class="row g-3">
                    <div class="col-md-4">
                        @Html.LabelFor(m => m.CaseId, "Kasa", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.DropDownListFor(m => m.CaseId, (SelectList)ViewBag.CashCases, "Seçiniz", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CaseId, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.CariID, "Cari", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.DropDownListFor(m => m.CariID, (SelectList)ViewBag.Customers, "Seçiniz", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.CariID, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Currency, "Para Birimi", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.DropDownListFor(m => m.Currency, new SelectList(new[]
                        {
                            new { Value="TRY", Text="₺ - Türk Lirası (TRY)" },
                            new { Value="USD", Text="$ - Amerikan Doları (USD)" },
                            new { Value="EUR", Text="€ - Euro (EUR)" },
                            new { Value="GBP", Text="£ - İngiliz Sterlini (GBP)" },
                            new { Value="CHF", Text="Fr. - İsviçre Frangı (CHF)" },
                            new { Value="CAD", Text="C$ - Kanada Doları (CAD)" },
                            new { Value="AUD", Text="A$ - Avustralya Doları (AUD)" },
                            new { Value="JPY", Text="¥ - Japon Yeni (JPY)" },
                            new { Value="CNY", Text="¥ - Çin Yuanı (CNY)" }
                        }, "Value", "Text", Model.Currency), "Seçiniz", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Currency, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Amount, "Tutar", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
                        @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Type, "Tür", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.DropDownListFor(m => m.Type, new SelectList(new[]
                        {
                            new { Value="Gelir", Text="Gelir" },
                            new { Value="Gider", Text="Gider" }
                        }, "Value", "Text", Model.Type), "Seçiniz", new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(m => m.Description, "Açıklama", new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger fs-12" })
                    </div>

                    <div class="col-12 d-flex gap-2 mt-4">
                        <a href="@Url.Action("CashTransactions", "Cash")" class="btn btn-outline-secondary w-50">İptal</a>
                        <button type="submit" class="btn btn-primary w-50">Güncelle</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>