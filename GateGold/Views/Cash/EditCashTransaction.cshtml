@model EntityLayer.Concrete.CaseTransaction

@{
    ViewBag.Title = "Kasa Hareketi Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center my-4 fw-bold text-primary">Kasa Hareketi Düzenle</h2>

@using (Html.BeginForm("EditCashTransaction", "Cash", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CaseTransactionId)

    <div class="row g-3 mt-3">
        <!-- Kasa -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.CaseId, "Kasa", new { @class = "form-label" })
            @Html.DropDownListFor(m => m.CaseId, (SelectList)ViewBag.CashCases, "Seçiniz", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.CaseId, "", new { @class = "text-danger" })
        </div>

        <!-- Cari -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.CariID, "Cari", new { @class = "form-label" })
            @Html.DropDownListFor(m => m.CariID, (SelectList)ViewBag.Customers, "Seçiniz", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.CariID, "", new { @class = "text-danger" })
        </div>

        <!-- Para Birimi -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.Currency, "Para Birimi", new { @class = "form-label" })
            @Html.DropDownListFor(m => m.Currency, new SelectList(new[]
            {
                new { Value="TRY", Text="₺ - Türk Lirası (TRY)" },
                new { Value="USD", Text="$ - Amerikan Doları (USD)" },
                new { Value="EUR", Text="€ - Euro (EUR)" },
                new { Value="GBP", Text="£ - İngiliz Sterlini (GBP)" },
                new { Value="CHF", Text="Fr. - İsviçre Frangı (CHF)" },
                new { Value="CAD", Text="C$ - Kanada Doları (CAD)" },
                new { Value="AUD", Text="A$ - Avustralya Doları (AUD)" },
                new { Value="JPY", Text="¥ - Japon Yeni (JPY)" },
                new { Value="CNY", Text="¥ - Çin Yuanı (CNY)" }
            }, "Value", "Text", Model.Currency), "Seçiniz", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Currency, "", new { @class = "text-danger" })
        </div>

        <!-- Tutar -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.Amount, "Tutar", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Amount, new { @class = "form-control", type = "number", step = "0.01" })
            @Html.ValidationMessageFor(m => m.Amount, "", new { @class = "text-danger" })
        </div>

        <!-- Tür -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.Type, "Tür", new { @class = "form-label" })
            @Html.DropDownListFor(m => m.Type, new SelectList(new[]
            {
                new { Value="Gelir", Text="Gelir" },
                new { Value="Gider", Text="Gider" }
            }, "Value", "Text", Model.Type), "Seçiniz", new { @class = "form-select" })
            @Html.ValidationMessageFor(m => m.Type, "", new { @class = "text-danger" })
        </div>

        <!-- Açıklama -->
        <div class="col-md-4">
            @Html.LabelFor(m => m.Description, "Açıklama", new { @class = "form-label" })
            @Html.TextBoxFor(m => m.Description, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
        </div>

        <!-- Kaydet Butonu -->
        <div class="col-12 mt-3">
            <button type="submit" class="btn btn-success w-100">Kaydet</button>
        </div>
    </div>
}
