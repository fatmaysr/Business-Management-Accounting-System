@{
    ViewBag.Title = "İşçilik Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .filter-box {
        border: 1px solid #ced4da;
        padding: 15px;
        border-radius: 6px;
        background-color: #f8f9fa;
        margin-bottom: 1.5rem;
        display: none; /* Başlangıçta gizli */
    }

    .filter-checkboxes .form-check {
        margin-right: 1.2rem;
        white-space: nowrap;
    }
</style>

<h2 class="text-center text-primary mb-4 fw-semibold">İşçilik Raporu</h2>

<div class="container" style="max-width: 900px;">
    <!-- Filtrele Toggle Butonu -->
    <div class="mb-3 text-end">
        <button id="toggleFilterBtn" type="button" class="btn btn-outline-primary btn-sm">
            Filtrele
        </button>
    </div>

    <!-- Filtre Alanları -->
    <form id="filterForm" method="get" class="filter-box" autocomplete="off">
        <!-- İlk Satır: ID, Tarih Başlangıç, Tarih Bitiş -->
        <div class="row g-3 mb-3">
            <div class="col-md-3">
                <label for="idFilter" class="form-label fw-semibold">ID</label>
                <input type="number" id="idFilter" name="id" class="form-control form-control-sm" placeholder="ID giriniz" />
            </div>

            <div class="col-md-4">
                <label for="startDate" class="form-label fw-semibold">Tarih Başlangıç</label>
                <input type="date" id="startDate" name="startDate" class="form-control form-control-sm" />
            </div>

            <div class="col-md-4">
                <label for="endDate" class="form-label fw-semibold">Tarih Bitiş</label>
                <input type="date" id="endDate" name="endDate" class="form-control form-control-sm" />
            </div>
        </div>

        <!-- İkinci Satır: Checkboxlar - 3 sütunlu düzen -->
        <div class="row mb-3">
            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="altinAlindi" name="filters" value="altinAlindi" />
                    <label class="form-check-label" for="altinAlindi">Altın Alındı</label>
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="altinVerildi" name="filters" value="altinVerildi" />
                    <label class="form-check-label" for="altinVerildi">Altın Verildi</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="nakitAlindi" name="filters" value="nakitAlindi" />
                    <label class="form-check-label" for="nakitAlindi">Nakit Alındı</label>
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="nakitVerildi" name="filters" value="nakitVerildi" />
                    <label class="form-check-label" for="nakitVerildi">Nakit Verildi</label>
                </div>
            </div>

            <div class="col-md-4">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="nakitAlindiGr" name="filters" value="nakitAlindiGr" />
                    <label class="form-check-label" for="nakitAlindiGr">Nakit Alındı (gr)</label>
                </div>
                <div class="form-check mt-2">
                    <input class="form-check-input" type="checkbox" id="nakitVerildiGr" name="filters" value="nakitVerildiGr" />
                    <label class="form-check-label" for="nakitVerildiGr">Nakit Verildi (gr)</label>
                </div>
            </div>
        </div>

        <!-- Butonlar -->
        <div class="text-end mt-2">
            <button type="submit" class="btn btn-primary btn-sm px-4 me-2">Uygula</button>
            <button type="button" id="resetFilterBtn" class="btn btn-outline-secondary btn-sm px-4">Temizle</button>
        </div>
    </form>
     
    <!--Tablo-->
    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle text-center">
            <thead class="table-primary text-dark fs-6 fw-semibold">
                <tr>
                    <th scope="col">ID</th>
                    <th scope="col">Tarih</th>
                    <th scope="col">Cari</th>
                    <th scope="col">Açıklama</th>
                    <th scope="col">Verilen</th>
                    <th scope="col">Alınan</th>
                    <th scope="col">Para Birimi</th>
                    <th scope="col">Kur</th>
                    <th scope="col">Has Fiyatı</th>
                    <th scope="col">İşlem</th>
                </tr>
            </thead>
   
        </table>
    </div>
</div>

<script>
    const toggleBtn = document.getElementById('toggleFilterBtn');
    const filterForm = document.getElementById('filterForm');
    const resetBtn = document.getElementById('resetFilterBtn');

    toggleBtn.addEventListener('click', () => {
        if (filterForm.style.display === 'none' || filterForm.style.display === '') {
            filterForm.style.display = 'block';
        } else {
            filterForm.style.display = 'none';
        }
    });

    resetBtn.addEventListener('click', () => {
        filterForm.reset();
    });
</script>
