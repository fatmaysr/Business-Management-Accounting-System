@using System.Linq
@model List<EntityLayer.Concrete.CaseTransaction>
@{
    ViewBag.Title = "Cari Hareket Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary text-center mb-4">Cari Hareket Raporu</h2>

<div class="container" style="max-width: 1100px;">
    <form method="get" class="row g-3 mb-4 align-items-end">
        <div class="col-md-4">
            <label class="form-label">Cari Seç</label>
            @{
                var customers = ViewBag.Customers as List<EntityLayer.Concrete.Customer>;
                var selectedCariId = ViewBag.SelectedCariId as int?;
            }
            <select name="cariId" class="form-select">
                <option value="">-- Tümü --</option>
                @foreach (var c in customers)
                {
                    if (selectedCariId.HasValue && selectedCariId.Value == c.CariID)
                    {
                        <option value="@c.CariID" selected="selected">@c.CariAdi</option>
                    }
                    else
                    {
                        <option value="@c.CariID">@c.CariAdi</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label">Tarih Başlangıç</label>
            <input type="date" name="startDate" class="form-control" value="@ViewBag.StartDate" />
        </div>
        <div class="col-md-3">
            <label class="form-label">Tarih Bitiş</label>
            <input type="date" name="endDate" class="form-control" value="@ViewBag.EndDate" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filtrele</button>
        </div>
    </form>

    <div class="row mb-4 text-center">
        <div class="col-md-6">
            <div class="card border-success">
                <div class="card-body">
                    <div class="text-muted">Toplam Giriş</div>
                    <div class="fs-4 fw-bold text-success">@(((decimal)ViewBag.ToplamGiris).ToString("N2"))</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-body">
                    <div class="text-muted">Toplam Çıkış</div>
                    <div class="fs-4 fw-bold text-danger">@(((decimal)ViewBag.ToplamCikis).ToString("N2"))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover text-center align-middle">
            <thead class="table-primary">
                <tr>
                    <th>Tarih</th>
                    <th>Cari</th>
                    <th>Tür</th>
                    <th>Tutar</th>
                    <th>Para Birimi</th>
                    <th>Açıklama</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-muted">Kayıt bulunamadı.</td></tr>
                }
                else
                {
                    foreach (var t in Model)
                    {
                        <tr>
                            <td>@t.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(t.Customer?.CariAdi)</td>
                            <td>
                                @if (t.Type == "Giriş")
                                {
                                    <span class="badge bg-success">Giriş</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Çıkış</span>
                                }
                            </td>
                            <td>@t.Amount.ToString("N2")</td>
                            <td>@t.Currency</td>
                            <td>@t.Description</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>