@{
    ViewBag.Title = "Cari Hareket Raporu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .filter-box {
        border: 1px solid #dee2e6;
        padding: 15px;
        border-radius: 6px;
        background-color: #f8f9fa;
        margin-bottom: 1.5rem;
        display: none;
    }

    .table th, .table td {
        font-size: 14px;
        vertical-align: middle;
    }

    .section-title {
        font-weight: 600;
        color: #0d6efd;
        margin-bottom: 10px;
    }
</style>

<h2 class="text-primary text-center mb-4">Cari Hareket Raporu</h2>

<div class="container" style="max-width: 1100px;">
    <!-- Filtreyi Aç Butonu -->
    <div class="mb-3 text-end">
        <button id="toggleFilterBtn" type="button" class="btn btn-outline-primary btn-sm">
            Filtrele
        </button>
    </div>

    <!-- Filtre Formu -->
    <form id="filterForm" method="get" class="filter-box">
        <div class="row g-3">
            <div class="col-md-4">
                <label for="cariSec" class="form-label">Cari Seç</label>
                <select id="cariSec" name="cari" class="form-select form-select-sm">
                    <option selected disabled>-- Cari Seçiniz --</option>
   
                </select>
            </div>

            <div class="col-md-2">
                <label for="idFilter" class="form-label">ID</label>
                <input type="number" id="idFilter" name="id" class="form-control form-control-sm" placeholder="ID" />
            </div>

            <div class="col-md-3">
                <label for="startDate" class="form-label">Tarih Başlangıç</label>
                <input type="date" id="startDate" name="startDate" class="form-control form-control-sm" />
            </div>

            <div class="col-md-3">
                <label for="endDate" class="form-label">Tarih Bitiş</label>
                <input type="date" id="endDate" name="endDate" class="form-control form-control-sm" />
            </div>
        </div>

        <!-- Checkboxlar -->
        <div class="row mt-3">
            <div class="col-md-12 d-flex flex-wrap gap-3">
                @foreach (var item in new[] {
                    "Altın Alındı", "Altın Verildi",
                    "Nakit Alındı", "Nakit Verildi",
                    "Nakit Alındı -> gr", "Nakit Verildi -> gr"
                })
                {
                    var id = item.ToLower().Replace(" ", "").Replace("->", "To");
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="@id" name="filters" value="@item" />
                        <label class="form-check-label" for="@id">@item</label>
                    </div>
                }
            </div>
        </div>

        <!-- Butonlar -->
        <div class="text-end mt-3">
            <button type="submit" class="btn btn-primary btn-sm px-4 me-2">Uygula</button>
            <button type="button" id="resetFilterBtn" class="btn btn-outline-secondary btn-sm px-4">Temizle</button>
        </div>
    </form>

    <!-- Cari Hareket Raporu Tablosu -->
    <div class="mt-4">
        <h5 class="section-title"style= "color:black">Cari Hareket Raporu</h5>
        <div class="table-responsive">
            <table class="table table-bordered table-hover text-center align-middle">
                <thead class="table-primary">
                    <tr>
                        <th>ID</th>
                        <th>Tarih</th>
                        <th>Cari</th>
                        <th>Tür</th>
                        <th>Alınan</th>
                        <th>Verilen</th>
                        <th>Para</th>
                        <th>Açıklama</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
         
            </table>
        </div>
    </div>

    <!-- Cari Toplam Tablosu -->
    <div class="mt-5">
        <h5 class="section-title" style=" color:black">Cari Toplam</h5>
        <div class="table-responsive">
            <table class="table table-bordered text-center align-middle">
                <thead class="table-primary fw-semibold">
                    <tr>
                        <th>Toplam Alınan</th>
                        <th>Toplam Verilen</th>
                        <th>Para Birimi</th>
                        <th>Bakiye</th>
                    </tr>
                </thead>
              
            </table>
        </div>
    </div>
</div>

<script>
    const toggleBtn = document.getElementById('toggleFilterBtn');
    const filterForm = document.getElementById('filterForm');
    const resetBtn = document.getElementById('resetFilterBtn');

    toggleBtn.addEventListener('click', () => {
        filterForm.style.display = filterForm.style.display === 'none' || filterForm.style.display === '' ? 'block' : 'none';
    });

    resetBtn.addEventListener('click', () => {
        filterForm.reset();
    });
</script>
