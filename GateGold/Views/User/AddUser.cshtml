@model EntityLayer.Concrete.User

@{
    ViewBag.Title = "Yeni Kullanıcı Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Yeni Kullanıcı Ekle</h3>
                <p class="text-muted fs-14 mb-0">Sisteme yeni bir kullanıcı ve rol tanımlayın.</p>
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">KULLANICI ADI</label>
                    @Html.TextBoxFor(x => x.UserName, new { @class = "form-control", placeholder = "Kullanıcı adı giriniz" })
                    @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">E-POSTA</label>
                    @Html.TextBoxFor(x => x.Email, new { @class = "form-control", type = "email", placeholder = "ornek@firma.com" })
                    @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">ŞİFRE</label>
                    @Html.PasswordFor(x => x.Password, new { @class = "form-control", placeholder = "••••••••" })
                    @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted fs-13 fw-semibold">ROL</label>
                    @Html.TextBoxFor(x => x.Role, new { @class = "form-control", placeholder = "Admin / Customer" })
                    @Html.ValidationMessageFor(x => x.Role, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("UserList", "User")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Kaydet</button>
                </div>

                <div class="mt-3">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger fs-13 text-center" })
                </div>
            }
        </div>
    </div>
</div>