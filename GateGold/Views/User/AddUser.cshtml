@model EntityLayer.Concrete.User

@{
    ViewBag.Title = "Yeni Kullanıcı Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-center">Yeni Kullanıcı Ekle</h2>

<div class="container" style="max-width: 500px;">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken() <!-- CSRF koruması için ekledik -->

        <div class="mb-3">
            <label class="form-label">Kullanıcı Adı</label>
            @Html.TextBoxFor(x => x.UserName, new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.UserName, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            @Html.TextBoxFor(x => x.Email, new { @class = "form-control", type = "email" })
            @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Şifre</label>
            @Html.PasswordFor(x => x.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
        </div>

        <div class="mb-3">
            <label class="form-label">Rol</label>
            @Html.TextBoxFor(x => x.Role, new { @class = "form-control", placeholder = "Admin / Customer" })
            @Html.ValidationMessageFor(x => x.Role, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Kaydet</button>
        <a href="@Url.Action("UserList", "User")" class="btn btn-secondary w-100 mt-2">İptal</a>

        <div class="mt-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </div>
    }
</div>
