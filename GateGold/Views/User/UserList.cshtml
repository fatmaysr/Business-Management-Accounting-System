@model List<EntityLayer.Concrete.User>

@{
    ViewBag.Title = "Kullanıcı Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Kullanıcılar</h2>
        <a href="@Url.Action("AddUser", "User")" class="btn btn-primary">+ Yeni Kullanıcı Ekle</a>
    </div>

    <table class="table table-bordered table-striped">
        <thead class="table-primary">
            <tr>
                <th>Id</th>
                <th>Kullanıcı Adı</th>
                <th>Email</th>
                <th>Rol</th>
                <th style="width: 20%;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                int index = 1;
                foreach (var item in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@item.UserName</td>
                        <td>@item.Email</td>
                        <td>@item.Role</td>
                        <td>
                            <a href="@Url.Action("EditUser", "User", new { id = item.UserId })" class="btn btn-warning btn-sm">Düzenle</a>
                            <a href="@Url.Action("DeleteUser", "User", new { id = item.UserId })" class="btn btn-danger btn-sm" onclick="return confirm('Silmek istediğinize emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Kayıtlı kullanıcı bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
