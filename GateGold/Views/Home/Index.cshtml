@model GateGold.Models.DashboardViewModel
@using System.Linq
@{
    ViewBag.Title = "Anasayfa";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="fw-bold my-4">Genel Bakış</h2>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted mb-2">Aktif Kasa</h6>
                <h3 class="fw-bold text-primary">@Model.AktifKasaSayisi</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted mb-2">Cari Hesap</h6>
                <h3 class="fw-bold text-success">@Model.CariSayisi</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted mb-2">Kullanıcı</h6>
                <h3 class="fw-bold text-info">@Model.KullaniciSayisi</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted mb-2">Bugünkü Hareket</h6>
                <h3 class="fw-bold text-warning">@Model.BugunkuHareketSayisi</h3>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h5 class="fw-bold mb-3">Son Kasa Hareketleri</h5>
        @if (Model.SonHareketler != null && Model.SonHareketler.Any())
        {
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Tip</th>
                        <th>Tutar</th>
                        <th>Para Birimi</th>
                        <th>Açıklama</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var h in Model.SonHareketler)
                    {
                        <tr>
                            <td>@h.Date.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@h.Type</td>
                            <td>@h.Amount.ToString("N2")</td>
                            <td>@h.Currency</td>
                            <td>@h.Description</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted mb-0">Henüz kayıtlı bir kasa hareketi yok.</p>
        }
    </div>
</div>