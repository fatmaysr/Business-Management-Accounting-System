@model GateGold.Models.GeneralSettingsViewModel
@{
    ViewBag.Title = "Genel Ayarlar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary text-center mb-4">Genel Ayarlar</h2>
<div class="container" style="max-width: 700px;">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @using (Html.BeginForm("General", "Settings", FormMethod.Post, new { @class = "p-4 border rounded shadow-sm bg-light" }))
    {
        @Html.AntiForgeryToken()

        <h5 class="text-secondary mb-3">Firma Bilgileri</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Firma Adı</label>
                @Html.TextBoxFor(m => m.FirmaAdi, new { @class = "form-control", placeholder = "Firma adı giriniz" })
            </div>
            <div class="col-md-6">
                <label class="form-label">E-posta</label>
                @Html.TextBoxFor(m => m.FirmaEmail, new { @class = "form-control", type = "email", placeholder = "ornek@firma.com" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Telefon</label>
                @Html.TextBoxFor(m => m.FirmaTelefon, new { @class = "form-control", placeholder = "0 5xx xxx xx xx" })
            </div>
            <div class="col-md-6">
                <label class="form-label">Adres</label>
                @Html.TextBoxFor(m => m.FirmaAdres, new { @class = "form-control", placeholder = "Firma adresi" })
            </div>
        </div>

        <h5 class="text-secondary mb-3">Finansal Ayarlar</h5>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label">Varsayılan Para Birimi</label>
                @Html.DropDownListFor(m => m.ParaBirimi, new[]
               {
                   new SelectListItem { Value = "TRY", Text = "₺ - Türk Lirası (TRY)" },
                   new SelectListItem { Value = "USD", Text = "$ - Amerikan Doları (USD)" },
                   new SelectListItem { Value = "EUR", Text = "€ - Euro (EUR)" },
                   new SelectListItem { Value = "GBP", Text = "£ - İngiliz Sterlini (GBP)" }
               }, new { @class = "form-select" })
            </div>
        </div>

        <div class="text-center">
            <button type="submit" class="btn btn-primary px-5">Kaydet</button>
        </div>
    }
</div>