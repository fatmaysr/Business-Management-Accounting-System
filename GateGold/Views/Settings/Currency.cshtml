
@{
    ViewBag.Title = "Currency";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary text-center mb-4">Kur Ayarları</h2>

<div class="table-responsive border rounded p-3 bg-light shadow-sm">
    <table class="table table-bordered align-middle text-center">
        <thead class="table-primary">
            <tr>
                <th>Para Birimi</th>
                <th>Kur Kaynağı</th>
                <th>Fiyat</th>
            </tr>
        </thead>
        <tbody>
            @{
                var paraBirimleri = new List<(string Kodu, string Gosterim)>
                    {
                    ("TRY", "₺ - Türk Lirası (TRY)"),
                    ("USD", "$ - Amerikan Doları (USD)"),
                    ("EUR", "€ - Euro (EUR)"),
                    ("GBP", "£ - İngiliz Sterlini (GBP)"),
                    ("CHF", "Fr. - İsviçre Frangı (CHF)"),
                    ("CAD", "C$ - Kanada Doları (CAD)"),
                    ("AUD", "A$ - Avustralya Doları (AUD)"),
                    ("JPY", "¥ - Japon Yeni (JPY)"),
                    ("CNY", "¥ - Çin Yuanı (CNY)"),
                    ("AED", "د.إ - BAE Dirhemi (AED)"),
                    ("SAR", "﷼ - Suudi Riyali (SAR)"),
                    ("RUB", "₽ - Rus Rublesi (RUB)"),
                    ("SEK", "kr - İsveç Kronu (SEK)"),
                    ("NOK", "kr - Norveç Kronu (NOK)"),
                    ("DKK", "kr - Danimarka Kronu (DKK)"),
                    ("INR", "₹ - Hindistan Rupisi (INR)"),
                    ("ZAR", "R - Güney Afrika Randı (ZAR)"),
                    ("BRL", "R$ - Brezilya Reali (BRL)"),
                    ("MXN", "$ - Meksika Pesosu (MXN)"),
                    ("KRW", "₩ - Güney Kore Wonu (KRW)")
                };

                foreach (var (kodu, gosterim) in paraBirimleri)
                {
                    <tr>
                        <td class="fw-semibold">@gosterim</td>
                        <td>
                            <select name="kurKaynak[@kodu]" class="form-select form-select-sm">
                                <option value="">Seçiniz</option>
                                <option value="merkez">Merkez Bankası</option>
                                <option value="serbest">Serbest Piyasa</option>
                                <option value="harem">Harem / Kapalıçarşı</option>
                            </select>
                        </td>
                        <td>
                            <input type="number" step="0.0001" name="kurFiyat[@kodu]" class="form-control form-control-sm" placeholder="0.0000" />
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="text-end mt-3">
        <button type="submit" class="btn btn-primary">Kaydet</button>
    </div>
</div>