<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="GateGold Yönetim Paneli" />
    <meta name="author" content="GateGold" />

    <title>GateGold || @ViewBag.Title</title>

    <!-- Favicon -->
    <link rel="shortcut icon" type="image/x-icon" href="@Url.Content("~/assets/images/favicon.ico")" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/bootstrap.min.css")" />

    <!-- Vendors CSS -->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/vendors/css/vendors.min.css")" />
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/vendors/css/daterangepicker.min.css")" />

    <!-- Custom CSS -->
    <link rel="stylesheet" type="text/css" href="@Url.Content("~/assets/css/theme.min.css")" />

    <!-- HTML5 shim and Respond.js for IE8 support -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.2/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
</head>

<body>
    <!--! [Start] Navigation Menu !-->
    <nav class="nxl-navigation">
        <div class="navbar-wrapper">
            <div class="m-header">
                <a href="@Url.Action("Index", "Home")" class="b-brand">
                    <img src="@Url.Content("~/assets/images/logo-full.png")" alt="GateGold" class="logo logo-lg" />
                    <img src="@Url.Content("~/assets/images/logo-abbr.png")" alt="GateGold" class="logo logo-sm" />
                </a>
            </div>
            <div class="navbar-content">
                <ul class="nxl-navbar">
                    <li class="nxl-item nxl-caption">
                        <label>Navigasyon</label>
                    </li>
                    <li class="nxl-item">
                        <a class="nxl-link" href="@Url.Action("Index", "Home")">
                            <span class="nxl-micon"><i class="feather-airplay"></i></span>
                            <span class="nxl-mtext">Anasayfa</span>
                        </a>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-users"></i></span>
                            <span class="nxl-mtext">Cari İşlemleri</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddCustomer","Customer")">Cari Tanımla</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("CustomerList","Customer")">Cari Listesi</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("DebtReport","Customer")">Cari Alacak & Borç</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("Balance","Customer")">Cari Bakiye</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("TransactionReport","Customer")">Cari Hesap Hareket Raporu</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-credit-card"></i></span>
                            <span class="nxl-mtext">Kasa</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("DailyCash","Cash")">Günlük Kasa</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("CashTransactions","Cash")">Kasa Hareketleri</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddCashTransaction","Cash")">Kasa Hareketi Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddCash","Cash")">Nakit Kasa Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("CashList","Cash")">Nakit Kasa Listesi</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-briefcase"></i></span>
                            <span class="nxl-mtext">Banka</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddBank", "Bank")">Banka Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("BankList", "Bank")">Banka Listesi</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddBankAccount", "Bank")">Banka Hesabı Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("BankAccountList", "Bank")">Banka Hesabı Listesi</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddBankTransaction", "Bank")">Banka Hareketi Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("BankTransactions", "Bank")">Banka Hareketleri</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-dollar-sign"></i></span>
                            <span class="nxl-mtext">Döviz</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddCurrency", "Currency")">Döviz Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("CurrencyBalanceList", "Currency")">Döviz Bakiye Listesi</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-shopping-cart"></i></span>
                            <span class="nxl-mtext">Perakende Satış</span>
                            <span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("QuickSale", "Retail")">Hızlı Satış</a></li>
                            <li class="nxl-item nxl-hasmenu">
                                <a href="javascript:void(0);" class="nxl-link">
                                    Ayarlar
                                    <span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                                </a>
                                <ul class="nxl-submenu">
                                    <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AllCategories", "Retail")">Tüm Kategoriler</a></li>
                                    <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddCategory", "Retail")">Kategori Ekle</a></li>
                                    <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AllProducts", "Retail")">Tüm Ürünler</a></li>
                                    <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddProduct", "Retail")">Ürün Ekle</a></li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-user"></i></span>
                            <span class="nxl-mtext">Kullanıcı Yönetimi</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddUser", "User")">Kullanıcı Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("UserList", "User")">Kullanıcılar</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-package"></i></span>
                            <span class="nxl-mtext">Toptan Satış</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AddStock", "Wholesale")">Stok Ekle</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("StockList", "Wholesale")">Stok Listesi</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-bar-chart-2"></i></span>
                            <span class="nxl-mtext">Raporlama</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("CashStatus", "Reporting")">Kasa Durum Raporu</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("Labor", "Reporting")">İşçilik Raporu</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("AccountMovements", "Reporting")">Cari Hareket Raporu</a></li>
                        </ul>
                    </li>
                    <li class="nxl-item nxl-hasmenu">
                        <a href="javascript:void(0);" class="nxl-link">
                            <span class="nxl-micon"><i class="feather-settings"></i></span>
                            <span class="nxl-mtext">Ayarlar</span><span class="nxl-arrow"><i class="feather-chevron-right"></i></span>
                        </a>
                        <ul class="nxl-submenu">
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("General", "Settings")">Genel Ayarlar</a></li>
                            <li class="nxl-item"><a class="nxl-link" href="@Url.Action("Currency", "Settings")">Kur Ayarları</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <!--! [End] Navigation Menu !-->
    <!--! [Start] Header !-->
    <header class="nxl-header">
        <div class="header-wrapper">
            <div class="header-left d-flex align-items-center gap-4">
                <a href="javascript:void(0);" class="nxl-head-mobile-toggler" id="mobile-collapse">
                    <div class="hamburger hamburger--arrowturn">
                        <div class="hamburger-box">
                            <div class="hamburger-inner"></div>
                        </div>
                    </div>
                </a>
                <div class="nxl-navigation-toggle">
                    <a href="javascript:void(0);" id="menu-mini-button">
                        <i class="feather-align-left"></i>
                    </a>
                    <a href="javascript:void(0);" id="menu-expend-button" style="display: none">
                        <i class="feather-arrow-right"></i>
                    </a>
                </div>
            </div>
            <div class="header-right ms-auto">
                <div class="d-flex align-items-center">
                    <div class="nxl-h-item d-none d-sm-flex">
                        <div class="full-screen-switcher">
                            <a href="javascript:void(0);" class="nxl-head-link me-0" onclick="$('body').fullScreenHelper('toggle');">
                                <i class="feather-maximize maximize"></i>
                                <i class="feather-minimize minimize"></i>
                            </a>
                        </div>
                    </div>
                    <div class="nxl-h-item dark-light-theme">
                        <a href="javascript:void(0);" class="nxl-head-link me-0 dark-button">
                            <i class="feather-moon"></i>
                        </a>
                        <a href="javascript:void(0);" class="nxl-head-link me-0 light-button" style="display: none">
                            <i class="feather-sun"></i>
                        </a>
                    </div>
                    <div class="dropdown nxl-h-item">
                        <a href="javascript:void(0);" data-bs-toggle="dropdown" role="button" data-bs-auto-close="outside">
                            <img src="@Url.Content("~/assets/images/avatar/1.png")" alt="user-image" class="img-fluid user-avtar me-0" />
                        </a>
                        <div class="dropdown-menu dropdown-menu-end nxl-h-dropdown nxl-user-dropdown">
                            <div class="dropdown-header">
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Content("~/assets/images/avatar/1.png")" alt="user-image" class="img-fluid user-avtar" />
                                    <div>
                                        <h6 class="text-dark mb-0">@User.Identity.Name</h6>
                                        <span class="fs-12 fw-medium text-muted">@(User.IsInRole("Admin") ? "Yönetici" : "Kullanıcı")</span>
                                    </div>
                                </div>
                            </div>
                            <div class="dropdown-divider"></div>
                            <a href="@Url.Action("Logout", "Login")" class="dropdown-item">
                                <i class="feather-log-out"></i>
                                <span>Çıkış Yap</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <!--! [End] Header !-->
    <!--! [Start] Main Content !-->
    <main class="nxl-container">
        <div class="nxl-content">
            <div class="page-header">
                <div class="page-header-left d-flex align-items-center">
                    <div class="page-header-title">
                        <h5 class="m-b-10">@ViewBag.Title</h5>
                    </div>
                </div>
            </div>
            <div class="main-content">
                <div class="row">
                    @RenderBody()
                </div>
            </div>
        </div>
        <footer class="footer">
            <p class="fs-11 text-muted fw-medium text-uppercase mb-0 copyright">
                <span>GateGold © </span>
                <script>document.write(new Date().getFullYear());</script>
            </p>
        </footer>
    </main>
    <!--! [End] Main Content !-->
    <!--! BEGIN: Vendors JS !-->
    <script src="@Url.Content("~/assets/vendors/js/vendors.min.js")"></script>
    <script src="@Url.Content("~/assets/vendors/js/daterangepicker.min.js")"></script>
    <script src="@Url.Content("~/assets/vendors/js/apexcharts.min.js")"></script>

    <script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
    <script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
    <!--! END: Vendors JS !-->
    <!--! BEGIN: Apps Init !-->
    <script src="@Url.Content("~/assets/js/common-init.min.js")"></script>
    <script src="@Url.Content("~/assets/js/dashboard-init.min.js")"></script>
    <!--! END: Apps Init !-->

    @RenderSection("scripts", required: false)
</body>

</html>