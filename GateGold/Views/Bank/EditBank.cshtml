@model EntityLayer.Concrete.Bank

@{
    ViewBag.Title = "Banka Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-6">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Banka Düzenle</h3>
                <p class="text-muted fs-14 mb-0">Mevcut banka bilgilerini güncelleyin.</p>
            </div>

            @using (Html.BeginForm("EditBank", "Bank", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.BankId)

                <div class="mb-3">
                    @Html.LabelFor(m => m.BankName, new { @class = "form-label text-muted fs-13 fw-semibold" })
                    @Html.TextBoxFor(m => m.BankName, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.BankName, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-3">
                    @Html.Label("Müşteri (Cari)", new { @class = "form-label text-muted fs-13 fw-semibold" })
                    @Html.DropDownList("CariID",
                        new SelectList((IEnumerable<EntityLayer.Concrete.Customer>)ViewBag.Customers, "CariID", "CariAdi", Model.CariID),
                        "Müşteri seçin", new { @class = "form-select" })
                </div>

                <div class="mb-3">
                    @Html.LabelFor(m => m.Branch, new { @class = "form-label text-muted fs-13 fw-semibold" })
                    @Html.TextBoxFor(m => m.Branch, new { @class = "form-control" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Phone, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                    </div>
                    <div class="col-md-6">
                        @Html.LabelFor(m => m.Status, new { @class = "form-label text-muted fs-13 fw-semibold" })
                        @Html.DropDownListFor(m => m.Status, new SelectList(new[] {
                            new { Text = "Aktif", Value = 1 },
                            new { Text = "Pasif", Value = 0 }
                        }, "Value", "Text", Model.Status), "Durum Seç", new { @class = "form-select" })
                    </div>
                </div>

                <div class="mb-4">
                    @Html.LabelFor(m => m.Address, new { @class = "form-label text-muted fs-13 fw-semibold" })
                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("BankList","Bank")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Güncelle</button>
                </div>
            }
        </div>
    </div>
</div>