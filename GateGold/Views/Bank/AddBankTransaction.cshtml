@model EntityLayer.Concrete.BankTransaction

@{
    ViewBag.Title = "Banka Hareketi Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-primary text-center">Banka Hareketi Ekle</h2>

<form method="post" action="@Url.Action("AddBankTransaction", "Bank")" class="row g-3">
    @Html.AntiForgeryToken() @* <-- CSRF Token Eklendi *@

    <div class="col-md-6">
        <label for="Date" class="form-label">Tarih <span class="text-danger">*</span></label>
        <input type="date" id="Date" name="Date" class="form-control" required />
    </div>

    <div class="col-md-6">
        <label for="BankId" class="form-label">Banka ID <span class="text-danger">*</span></label>
        <input type="number" id="BankId" name="BankId" class="form-control" required />
    </div>

    <div class="col-md-6">
        <label for="CustomerId" class="form-label">Müşteri ID <span class="text-danger">*</span></label>
        <input type="number" id="CustomerId" name="CustomerId" class="form-control" required />
    </div>

    <div class="col-md-6">
        <label for="BankAccountId" class="form-label">Banka Hesap ID <span class="text-danger">*</span></label>
        <input type="number" id="BankAccountId" name="BankAccountId" class="form-control" required />
    </div>

    <div class="col-md-6">
        <label for="Currency" class="form-label">Para Birimi</label>
        <input type="text" id="Currency" name="Currency" class="form-control" />
    </div>

    <div class="col-md-6">
        <label for="Price" class="form-label">Tutar</label>
        <input type="text" id="Price" name="Price" class="form-control" />
    </div>

    <div class="col-md-6">
        <label for="Type" class="form-label">Tür</label>
        <input type="number" id="Type" name="Type" class="form-control" />
    </div>

    <div class="col-md-6">
        <label for="Method" class="form-label">Metot</label>
        <input type="number" id="Method" name="Method" class="form-control" />
    </div>

    <div class="col-md-6">
        <label for="Status" class="form-label">Durum</label>
        <input type="number" id="Status" name="Status" class="form-control" />
    </div>

    <div class="col-12">
        <label for="Content" class="form-label">İçerik</label>
        <textarea id="Content" name="Content" class="form-control"></textarea>
    </div>

    <div class="col-12">
        <label for="CurrentToken" class="form-label">Current Token</label>
        <input type="text" id="CurrentToken" name="CurrentToken" class="form-control" />
    </div>

    <div class="col-12">
        <label for="SecretToken" class="form-label">Secret Token</label>
        <input type="text" id="SecretToken" name="SecretToken" class="form-control" />
    </div>

    <div class="col-12 d-flex justify-content-end gap-2">
        <a href="@Url.Action("BankTransactions", "Bank")" class="btn btn-outline-secondary">İptal</a>
        <button type="submit" class="btn btn-primary">Kaydet</button>
    </div>
</form>