@model EntityLayer.Concrete.Bank

@{
    ViewBag.Title = "Banka Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-primary mb-4">Yeni Banka Ekle</h2>

@using (Html.BeginForm("AddBank", "Bank", FormMethod.Post))
{
    @Html.AntiForgeryToken() @* <-- CSRF Token Eklendi *@

    <div class="mb-3">
        @Html.LabelFor(m => m.BankName)
        @Html.TextBoxFor(m => m.BankName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.BankName)
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Branch)
        @Html.TextBoxFor(m => m.Branch, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Phone)
        @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Address)
        @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
    </div>

    <div class="mb-3">
        @Html.LabelFor(m => m.Status)
        @Html.DropDownListFor(m => m.Status, new SelectList(new[] {
            new { Text = "Aktif", Value = 1 },
            new { Text = "Pasif", Value = 0 }
        }, "Value", "Text"), "Durum Seç", new { @class = "form-control" })
    </div>

    <button type="submit" class="btn btn-success">Kaydet</button>
    <a href="@Url.Action("BankList","Bank")" class="btn btn-secondary">Geri</a>
}