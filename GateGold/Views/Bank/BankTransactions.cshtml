@model IEnumerable<EntityLayer.Concrete.BankTransaction>

@{
    ViewBag.Title = "BankTransactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-primary text-center">Banka Hareketleri</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <a href="@Url.Action("AddBankTransaction", "Bank")" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-2"></i>Yeni Banka Hareketi Ekle
        </a>
    </div>
</div>

<div class="table-responsive shadow-sm rounded">
    <table class="table table-bordered table-hover align-middle text-center mb-0">
        <thead class="table-primary">
            <tr>
                <th>ID</th>
                <th>Tarih</th>
                <th>Banka ID</th>
                <th>Müşteri ID</th>
                <th>Hesap ID</th>
                <th>Para Birimi</th>
                <th>Tutar</th>
                <th>Tür</th>
                <th>İçerik</th>
                <th>Metot</th>
                <th>Durum</th>
                <th>İşlem</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Date.ToString("dd.MM.yyyy")</td>
                    <td>@item.BankId</td>
                    <td>@item.CustomerId</td>
                    <td>@item.BankAccountId</td>
                    <td>@item.Cuurency</td>
                    <td>@item.Price</td>
                    <td>@item.Type</td>
                    <td>@item.Content</td>
                    <td>@item.Method</td>
                    <td>@item.Status</td>
                    <td>
                        <a href="@Url.Action("EditBankTransaction", "Bank", new { id = item.Id })" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                        <a href="@Url.Action("DeleteBankTransaction", "Bank", new { id = item.Id })"
                           onclick="return confirm('Bu hareketi silmek istediğinize emin misiniz?');"
                           class="btn btn-sm btn-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
