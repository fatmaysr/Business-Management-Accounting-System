@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Nexus || Şifre Sıfırlama</title>
    <link rel="stylesheet" type="text/css" href="./../assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="./../assets/css/theme.min.css">
</head>
<body class="bg-light">

    <div class="d-flex align-items-center justify-content-center vh-100">
        <div class="card shadow-lg border-0 p-4 rounded-4" style="max-width: 420px; width: 100%; border-radius: 20px !important;">

            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Şifre Sıfırlama</h3>
                <p class="text-muted fs-14">Kayıtlı e-posta adresinizi girin ve yeni şifrenizi belirleyin.</p>
            </div>

            <form action="@Url.Action("ResetPassword", "Login")" method="post">
                @Html.AntiForgeryToken()

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 fs-13 border-0 rounded-3">@ViewBag.Error</div>
                }
                @if (ViewBag.Success != null)
                {
                    <div class="alert alert-success py-2 fs-13 border-0 rounded-3">@ViewBag.Success</div>
                }

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">E-POSTA ADRESİ</label>
                    <input type="email" class="form-control" name="email" placeholder="ornek@firma.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">YENİ ŞİFRE</label>
                    <input type="password" class="form-control" name="newPassword" placeholder="••••••••" required />
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted fs-13 fw-semibold">ŞİFREYİ ONAYLA</label>
                    <input type="password" class="form-control" name="confirmPassword" placeholder="••••••••" required />
                </div>

                <button type="submit" class="btn btn-primary w-100 py-2 shadow-sm fw-semibold">
                    Şifreyi Sıfırla
                </button>

                <div class="text-center mt-3">
                    <a href="@Url.Action("Login", "Login")" class="text-muted fs-13 text-decoration-none">&laquo; Giriş sayfasına dön</a>
                </div>
            </form>
        </div>
    </div>

</body>
</html>