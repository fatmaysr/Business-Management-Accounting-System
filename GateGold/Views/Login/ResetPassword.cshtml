@{
    Layout = null;
}

<div class="d-flex align-items-center justify-content-center vh-100 bg-light">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 400px; width: 100%;">
        <h3 class="text-center mb-3">Şifre Sıfırlama</h3>
        <p class="text-muted text-center small mb-4">
            Kayıtlı e-posta adresinizi girin ve yeni şifrenizi belirleyin.
        </p>

        <form action="@Url.Action("ResetPassword", "Login")" method="post">
            @Html.AntiForgeryToken()

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger py-2">@ViewBag.Error</div>
            }
            @if (ViewBag.Success != null)
            {
                <div class="alert alert-success py-2">@ViewBag.Success</div>
            }

            <div class="mb-3">
                <input type="email" class="form-control form-control-lg" name="email" placeholder="E-posta adresiniz" required />
            </div>

            <div class="mb-3">
                <input type="password" class="form-control form-control-lg" name="newPassword" placeholder="Yeni şifre" required />
            </div>

            <div class="mb-3">
                <input type="password" class="form-control form-control-lg" name="confirmPassword" placeholder="Şifreyi onayla" required />
            </div>

            <button type="submit" class="btn w-100 rounded-3 py-2"
                    style="background: linear-gradient(135deg, #4e73df, #224abe); color: #fff; border: none;">
                Şifreyi Sıfırla
            </button>

        </form>
    </div>
</div>
