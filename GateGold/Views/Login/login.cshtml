@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="Nexus Yönetim Paneli Giriş">
    <title>Nexus || Giriş</title>
    <link rel="shortcut icon" type="image/x-icon" href="./../assets/images/favicon.ico">
    <link rel="stylesheet" type="text/css" href="./../assets/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="./../assets/vendors/css/vendors.min.css">
    <link rel="stylesheet" type="text/css" href="./../assets/css/theme.min.css">
</head>

<body class="bg-light">
    <main class="auth-creative-wrapper">
        <div class="auth-creative-inner">
            <div class="creative-card-wrapper">
                <div class="card my-4 overflow-hidden border-0 shadow-lg" style="border-radius: 20px !important; z-index: 1;">
                    <div class="row flex-1 g-0">
                        <div class="col-lg-6 h-100 my-auto order-1 order-lg-0 bg-white p-4 p-sm-5">
                            <div class="wd-50 bg-white p-2 rounded-circle shadow position-absolute translate-middle top-50 start-50 d-none d-lg-block">
                                <img src="~/assets/images/auth/logo.png" class="img-fluid" />
                            </div>

                            <div class="mb-4">
                                <h2 class="fs-24 fw-bold text-dark mb-1">Hoş Geldiniz</h2>
                                <p class="text-muted fs-14">Devam etmek için hesabınıza giriş yapın.</p>
                            </div>

                            <!-- Form: MVC uyumlu -->
                            <form method="post" action="@Url.Action("Login", "Login")" class="w-100 mt-3">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="form-label text-muted fs-13 fw-semibold">KULLANICI ADI / E-POSTA</label>
                                    <input type="text" name="username" class="form-control" placeholder="Kullanıcı adınız" required />
                                </div>

                                <div class="mb-3">
                                    <label class="form-label text-muted fs-13 fw-semibold">ŞİFRE</label>
                                    <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                                </div>

                                <div class="d-flex align-items-center justify-content-between mb-4">
                                    <div class="form-check">
                                        <input type="checkbox" name="rememberMe" class="form-check-input" id="rememberMe" value="true" />
                                        <label class="form-check-label text-muted fs-13 c-pointer" for="rememberMe">Beni Hatırla</label>
                                    </div>
                                    <div>
                                        <a href="@Url.Action("ResetPassword", "Login")" class="fs-13 text-primary fw-semibold text-decoration-none">Şifremi Unuttum?</a>
                                    </div>
                                </div>

                                <div>
                                    <button type="submit" class="btn btn-lg btn-primary w-100 py-2 shadow-sm">Giriş Yap</button>
                                </div>
                            </form>

                            <!-- Hata mesajı -->
                            @if (ViewBag.Error != null)
                            {
                                <div class="alert alert-danger mt-3 rounded-3 border-0 fs-13 shadow-sm">
                                    @ViewBag.Error
                                </div>
                            }
                        </div>

                        <div class="col-lg-6 bg-primary order-0 order-lg-1 d-none d-lg-flex align-items-center justify-content-center p-5">
                            <div class="text-center text-white">
                                <img src="~/assets/images/auth/dashboard.png" class="img-fluid rounded-4 shadow-lg mb-3" style="max-height: 300px; object-fit: cover;" />
                                <h4 class="fw-bold text-white">Nexus Finans & Yönetim</h4>
                                <p class="text-white-50 fs-14">Tüm operasyonlarınız tek bir akıllı merkezde.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script src="./../assets/vendors/js/vendors.min.js"></script>
    <script src="./../assets/js/common-init.min.js"></script>
    <script src="./../assets/js/theme-customizer-init.min.js"></script>
</body>

</html>