@model EntityLayer.Concrete.FastSaleCategory

@{
    ViewBag.Title = "Kategori Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Kategori Düzenle</h3>
                <p class="text-muted fs-14 mb-0">Mevcut kategori bilgilerini güncelleyin.</p>
            </div>

            @using (Html.BeginForm("EditCategory", "Retail", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.CategoryId)

                <div class="mb-3">
                    @Html.LabelFor(m => m.CategoryName, new { @class = "form-label text-muted fs-13 fw-semibold" })
                    @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", placeholder = "Kategori adını girin" })
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a href="@Url.Action("AllCategories", "Retail")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Güncelle</button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3 rounded-3 border-0 shadow-sm fs-13">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
        </div>
    </div>
</div>