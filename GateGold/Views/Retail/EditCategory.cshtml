@model EntityLayer.Concrete.FastSaleCategory

@{
    ViewBag.Title = "Kategori Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-center">Kategori Düzenle</h2>

<div class="container" style="max-width: 500px;">
    @using (Html.BeginForm("EditCategory", "Retail", FormMethod.Post))
    {
        @Html.AntiForgeryToken() @* <-- CSRF Token Eklendi *@
        @Html.HiddenFor(m => m.CategoryId)

        <div class="mb-3">
            @Html.LabelFor(m => m.CategoryName, new { @class = "form-label" })
            @Html.TextBoxFor(m => m.CategoryName, new { @class = "form-control", placeholder = "Kategori adını girin" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Güncelle</button>
        <a href="@Url.Action("AllCategories", "Retail")" class="btn btn-secondary w-100 mt-2">İptal</a>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
</div>