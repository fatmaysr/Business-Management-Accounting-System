@model EntityLayer.Concrete.FastSaleProduct

@{
    ViewBag.Title = "Ürün Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Ürün Düzenle</h3>
                <p class="text-muted fs-14 mb-0">Seçilen hızlı satış ürünü bilgilerini güncelleyin.</p>
            </div>

            @using (Html.BeginForm("EditProduct", "Retail", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ProductId)

                <div class="mb-3">
                    <label for="productName" class="form-label text-muted fs-13 fw-semibold">ÜRÜN ADI</label>
                    @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Ürün adını girin", required = "required" })
                </div>

                <div class="mb-3">
                    <label for="category" class="form-label text-muted fs-13 fw-semibold">KATEGORİ SEÇİNİZ</label>
                    <select id="category" name="Category" class="form-select" required>
                        <option value="" disabled>Bir kategori seçin</option>
                        @if (ViewBag.Categories != null)
                        {
                            foreach (var cat in ViewBag.Categories as List<EntityLayer.Concrete.FastSaleCategory>)
                            {
                                <option value="@cat.CategoryName" @(Model.Category == cat.CategoryName ? "selected" : "")>
                                    @cat.CategoryName
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label for="value" class="form-label text-muted fs-13 fw-semibold">ÜRÜN DEĞERİ / FİYATI (₺)</label>
                    @Html.TextBoxFor(m => m.Value, new { @class = "form-control", placeholder = "0.00" })
                </div>

                <div class="d-flex gap-2 mt-4">
                    <a href="@Url.Action("AllProducts", "Retail")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Güncelle</button>
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger mt-3 rounded-3 border-0 shadow-sm fs-13">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p class="mb-0">@error.ErrorMessage</p>
                    }
                </div>
            }
        </div>
    </div>
</div>