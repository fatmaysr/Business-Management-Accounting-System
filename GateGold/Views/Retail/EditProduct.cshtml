@model EntityLayer.Concrete.FastSaleProduct

@{
    ViewBag.Title = "Ürün Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-center">Ürün Düzenle</h2>

<div class="container" style="max-width: 500px;">
    @using (Html.BeginForm("EditProduct", "Retail", FormMethod.Post))
    {
        @Html.HiddenFor(m => m.ProductId)

        <div class="mb-3">
            <label for="productName" class="form-label">Ürün Adı</label>
            @Html.TextBoxFor(m => m.ProductName, new { @class = "form-control", placeholder = "Ürün adını girin", required = "required" })
        </div>

        <div class="mb-3">
            <label for="category" class="form-label">Kategori Seçiniz</label>
            <select id="category" name="Category" class="form-select" required>
                <option value="" disabled>Bir kategori seçin</option>
                @if (ViewBag.Categories != null)
                {
                    foreach (var cat in ViewBag.Categories as List<EntityLayer.Concrete.FastSaleCategory>)
                    {
                        <option value="@cat.CategoryName" @(Model.Category == cat.CategoryName ? "selected" : "")>
                            @cat.CategoryName
                        </option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label for="value" class="form-label">Ürün Değeri</label>
            @Html.TextBoxFor(m => m.Value, new { @class = "form-control", placeholder = "Ürün değerini girin" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Güncelle</button>
        <a href="@Url.Action("AllProducts", "Retail")" class="btn btn-secondary w-100 mt-2">İptal</a>
    }
</div>
