@{
    ViewBag.Title = "Kart ile Ödeme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <div class="bg-soft-primary p-3 rounded-circle d-inline-flex mb-3 text-primary" style="width: 60px; height: 60px; align-items: center; justify-content: center;">
                    <i class="feather-credit-card fs-4"></i>
                </div>
                <h3 class="fw-bold text-dark mb-1">Kart ile Ödeme</h3>
                <p class="text-muted fs-14 mb-0">Kredi kartı bilgilerini girerek işlemi tamamlayın.</p>
            </div>

            <form method="post" action="/Retail/CardPayment">
                @Html.AntiForgeryToken()
                <input type="hidden" name="category" value="@ViewBag.Category" />
                <input type="hidden" name="product" value="@ViewBag.Product" />

                <div class="mb-3">
                    <label for="cardNumber" class="form-label text-muted fs-13 fw-semibold">KART NUMARASI</label>
                    <input type="text" class="form-control" id="cardNumber" name="cardNumber" placeholder="0000 0000 0000 0000" required />
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <label for="expiryDate" class="form-label text-muted fs-13 fw-semibold">SKT</label>
                        <input type="text" class="form-control" id="expiryDate" name="expiryDate" placeholder="AA/YY" required />
                    </div>
                    <div class="col-6">
                        <label for="cvv" class="form-label text-muted fs-13 fw-semibold">CVV</label>
                        <input type="password" class="form-control" id="cvv" name="cvv" placeholder="123" maxlength="3" required />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <a href="javascript:history.back()" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Ödemeyi Tamamla</button>
                </div>
            </form>
        </div>
    </div>
</div>