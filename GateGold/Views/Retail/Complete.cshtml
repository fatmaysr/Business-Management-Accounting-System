@model EntityLayer.Concrete.Sale
@{
    ViewBag.Title = "Satış Tamamlandı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow-sm border-priamry">
        <div class="card-header bg-primary text-white text-center">
            <h2 class="text-white">Satış Başarıyla Tamamlandı!</h2>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-4">Ürün:</dt>
                <dd class="col-sm-8 fw-bold">@Model.ProductName</dd>

                <dt class="col-sm-4">Tutar:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Price.ToString("N2") ₺</dd>

                <dt class="col-sm-4">Ödeme Türü:</dt>
                <dd class="col-sm-8 fw-bold text-capitalize">@Model.PaymentType</dd>

                <dt class="col-sm-4">Tarih:</dt>
                <dd class="col-sm-8 fw-bold">@Model.Date.ToString("dd.MM.yyyy HH:mm")</dd>

                <dt class="col-sm-4">Satış No:</dt>
                <dd class="col-sm-8 fw-bold">#@Model.SaleId</dd>
            </dl>
            <div class="text-center mt-4">
                <a href="@Url.Action("QuickSale", "Retail")" class="btn btn-primary btn-lg px-4">
                    Yeni Satış Yap
                </a>
            </div>
        </div>
    </div>
</div>