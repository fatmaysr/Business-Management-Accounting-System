@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "QuickSale";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="text-center text-primary mt-4 mb-5">Kategori Seçin</h2>

<form method="get" action="/Retail/ProductSelection">
    <div class="container">
        <div class="row justify-content-center g-4">

            @{
                var categories = ViewBag.Categories as List<EntityLayer.Concrete.FastSaleCategory>;
            }

            @if (categories == null || !categories.Any())
            {
                <div class="col-12 text-center text-muted">
                    Henüz kategori eklenmemiş. Önce <a href="@Url.Action("AddCategory", "Retail")">bir kategori ekleyin</a>.
                </div>
            }
            else
            {
                foreach (var cat in categories)
                {
                    <div class="col-md-3">
                        <input type="radio" name="category" value="@cat.CategoryName" class="d-none category-radio" id="cat_@cat.CategoryId" />
                        <label for="cat_@cat.CategoryId" class="card shadow-sm border-0 h-100 text-center category-card d-block p-4" style="cursor:pointer;">
                            <i class="feather-tag" style="font-size:48px; color:#5b6fe6;"></i>
                            <span class="card-title text-dark mt-2" style="display:block; font-size:1.15rem; font-weight:600;">@cat.CategoryName</span>
                        </label>
                    </div>
                }
            }

            <div class="text-center mt-5">
                <button type="submit" id="continueBtn" class="btn btn-primary btn-lg px-5" disabled>Devam Et</button>
            </div>
        </div>
    </div>
</form>
<style>
    .category-card.selected {
        border: 3px solid #007bff !important;
        box-shadow: 0 0 15px rgba(0, 123, 255, 0.5) !important;
    }
</style>

<script>
    document.querySelectorAll('.category-radio').forEach(function (radio) {
        radio.addEventListener('change', function () {
            document.querySelectorAll('.category-card').forEach(card => card.classList.remove('selected'));
            var label = document.querySelector('label[for="' + this.id + '"]');
            if (label) {
                label.classList.add('selected');
            }
            document.getElementById('continueBtn').disabled = false;
        });
    });
</script>