@model EntityLayer.Concrete.FastSaleCategory
@{
    ViewBag.Title = "Kategori Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4 text-center">Yeni Kategori Ekle</h2>

<div class="container" style="max-width: 500px;">
    @using (Html.BeginForm("AddCategory", "Retail", FormMethod.Post))
    {
        <div class="mb-3">
            <label for="categoryName" class="form-label">Kategori Adı</label>
            <input type="text" id="categoryName" name="categoryName" class="form-control" placeholder="Kategori adını girin" required />
        </div>

        <button type="submit" class="btn btn-primary w-100">Kaydet</button>
        <a href="@Url.Action("AllCategories", "Retail")" class="btn btn-secondary w-100 mt-2">İptal</a>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <p>@error.ErrorMessage</p>
            }
        </div>
    }
</div>
