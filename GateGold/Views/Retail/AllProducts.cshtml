@model List<EntityLayer.Concrete.FastSaleProduct>
@{
    ViewBag.Title = "Tüm Ürünler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Tüm Ürünler</h2>
        <a href="@Url.Action("AddProduct", "Retail")" class="btn btn-primary">+ Yeni Ürün Ekle</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-primary">
            <tr>
                <th>#</th>
                <th>Ürün Adı</th>
                <th>Kategori</th>
                <th>Değer / Fiyat</th>
                <th style="width: 20%;">İşlemler</th> <!-- Düzenle/Sil sütunu -->
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int index = 1;
                foreach (var product in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@product.ProductName</td>
                        <td>@product.Category</td>
                        <td>@product.Value</td>
                        <td>
                            <a href="@Url.Action("EditProduct", "Retail", new { id = product.ProductId })"
                               class="btn btn-sm btn-warning me-2">Düzenle</a>

                            <a href="@Url.Action("DeleteProduct", "Retail", new { id = product.ProductId })"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Bu ürünü silmek istediğinizden emin misiniz?');">Sil</a>

                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">Kayıtlı ürün bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
