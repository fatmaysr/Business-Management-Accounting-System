@model List<EntityLayer.Concrete.FastSaleCategory>
@{
    ViewBag.Title = "Tüm Kategoriler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Tüm Kategoriler</h2>
        <a href="@Url.Action("AddCategory", "Retail")" class="btn btn-primary">+ Yeni Kategori Ekle</a>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-primary">
            <tr>
                <th style="width: 5%;">#</th>
                <th>Kategori Adı</th>
                <th style="width: 20%;">İşlemler</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                int index = 1;
                foreach (var category in Model)
                {
                    <tr>
                        <td>@index</td>
                        <td>@category.CategoryName</td>
                        <td>
                            <a href="@Url.Action("EditCategory", "Retail", new { id = category.CategoryId })" class="btn btn-sm btn-warning me-2">Düzenle</a>
                            <a href="@Url.Action("DeleteCategory", "Retail", new { id = category.CategoryId })" class="btn btn-sm btn-danger" onclick="return confirm('Bu kategoriyi silmek istediğinizden emin misiniz?');">Sil</a>
                        </td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">Kayıtlı kategori bulunmamaktadır.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
