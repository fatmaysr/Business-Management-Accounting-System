@model EntityLayer.Concrete.Stock

@{
    ViewBag.Title = "Stok Kartı Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3 text-primary text-center">Stok Kartı Ekle</h2>

<div class="container" style="max-width: 480px;">
    @using (Html.BeginForm("AddStock", "Wholesale", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Stok Adı</label>
            @Html.TextBoxFor(x => x.StockName, new { @class = "form-control form-control-sm", placeholder = "Stok adı giriniz", required = "required" })
            @Html.ValidationMessageFor(x => x.StockName, "", new { @class = "text-danger" })
        </div>

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Miktar</label>
            @Html.TextBoxFor(x => x.Quantity, new { type = "number", @class = "form-control form-control-sm", placeholder = "Miktar giriniz", min = "0" })
            @Html.ValidationMessageFor(x => x.Quantity, "", new { @class = "text-danger" })
        </div>

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Birim Fiyat</label>
            @Html.TextBoxFor(x => x.Price, new { type = "number", step = "0.01", @class = "form-control form-control-sm", placeholder = "Birim fiyat giriniz", min = "0" })
            @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Kaydet</button>

        <div class="mt-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </div>
    }
</div>
