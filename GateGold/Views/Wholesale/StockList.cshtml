@model List<EntityLayer.Concrete.Stock>

@{
    ViewBag.Title = "Stok Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">Stok Yönetimi</h2>
        <p class="text-muted fs-14 mb-0">Deponuzdaki mevcut envanteri ve birim fiyatları takip edin.</p>
    </div>
    <a href="@Url.Action("AddStock", "Wholesale")" class="btn btn-primary">
        <i class="feather-plus me-1"></i> Yeni Stok Ekle
    </a>
</div>

<div class="card border-0 shadow-sm p-3" style="border-radius: 16px !important;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted fs-12">
                <tr>
                    <th style="width: 8%;">ID</th>
                    <th>Stok Adı</th>
                    <th>Miktar</th>
                    <th>Birim Fiyat</th>
                    <th>Oluşturma Tarihi</th>
                    <th style="width: 20%;">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted">@item.StockId</td>
                            <td class="fw-semibold text-dark">@item.StockName</td>
                            <td>
                                <span class="badge bg-soft-info text-info">@item.Quantity Adet</span>
                            </td>
                            <td class="fw-bold text-success">@item.Price.ToString("C")</td>
                            <td class="text-muted">@item.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a href="@Url.Action("EditStock", "Wholesale", new { id = item.StockId })" class="btn btn-sm btn-soft-warning text-warning px-3">Düzenle</a>
                                    <a href="@Url.Action("DeleteStock", "Wholesale", new { id = item.StockId })" class="btn btn-sm btn-soft-danger text-danger px-3" onclick="return confirm('Bu kaydı silmek istediğinize emin misiniz?');">Sil</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Henüz kayıtlı stok bulunmamaktadır.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>