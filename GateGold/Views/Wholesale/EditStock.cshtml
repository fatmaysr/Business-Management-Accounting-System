@model EntityLayer.Concrete.Stock

@{
    ViewBag.Title = "Stok Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-3 text-primary text-center">Stok Düzenle</h2>

<div class="container" style="max-width: 480px;">
    @using (Html.BeginForm("EditStock", "Wholesale", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.HiddenFor(x => x.StockId)

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Stok Adı</label>
            @Html.TextBoxFor(x => x.StockName, new { @class = "form-control form-control-sm", required = "required" })
            @Html.ValidationMessageFor(x => x.StockName, "", new { @class = "text-danger" })
        </div>

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Miktar</label>
            @Html.TextBoxFor(x => x.Quantity, new { type = "number", @class = "form-control form-control-sm", min = "0" })
            @Html.ValidationMessageFor(x => x.Quantity, "", new { @class = "text-danger" })
        </div>

        <div class="col-12 mb-3">
            <label class="form-label fw-semibold">Birim Fiyat</label>
            @Html.TextBoxFor(x => x.Price, new { type = "number", step = "0.01", @class = "form-control form-control-sm", min = "0" })
            @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger" })
        </div>

        <button type="submit" class="btn btn-primary w-100">Güncelle</button>
        <a href="@Url.Action("StockList", "Wholesale")" class="btn btn-secondary w-100 mt-2">İptal</a>

        <div class="mt-3">
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        </div>
    }
</div>
