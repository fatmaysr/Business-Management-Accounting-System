@model EntityLayer.Concrete.Stock

@{
    ViewBag.Title = "Stok Düzenle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm p-4" style="border-radius: 16px !important;">
            <div class="text-center mb-4">
                <h3 class="fw-bold text-dark mb-1">Stok Düzenle</h3>
                <p class="text-muted fs-14 mb-0">Mevcut stok kartı bilgilerini güncelleyin.</p>
            </div>

            @using (Html.BeginForm("EditStock", "Wholesale", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(x => x.StockId)

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">STOK ADI</label>
                    @Html.TextBoxFor(x => x.StockName, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(x => x.StockName, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-3">
                    <label class="form-label text-muted fs-13 fw-semibold">MİKTAR</label>
                    @Html.TextBoxFor(x => x.Quantity, new { type = "number", @class = "form-control", min = "0" })
                    @Html.ValidationMessageFor(x => x.Quantity, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="mb-4">
                    <label class="form-label text-muted fs-13 fw-semibold">BİRİM FİYAT (₺)</label>
                    @Html.TextBoxFor(x => x.Price, new { type = "number", step = "0.01", @class = "form-control", min = "0" })
                    @Html.ValidationMessageFor(x => x.Price, "", new { @class = "text-danger fs-12" })
                </div>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("StockList", "Wholesale")" class="btn btn-outline-secondary w-50">İptal</a>
                    <button type="submit" class="btn btn-primary w-50">Güncelle</button>
                </div>

                <div class="mt-3">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger fs-13 text-center" })
                </div>
            }
        </div>
    </div>
</div>